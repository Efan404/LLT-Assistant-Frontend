{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": [
			"ES2020",
			"DOM"
		],
		"rootDir": "./",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src",
		"test",
		"*/*.ts",
		"**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"out",
		"src/test/**/*.test.ts",
		"src/test/**/*.spec.ts",
		"src/test/mocks/**",
		"src/test/helpers/**",
		"src/test/fixtures/**"
	]
}
